# ─────────────────────────────────────────────────────────────
# ForceCar — variabile de mediu
# Copiază acest fișier în `.env.local` (dezvoltare) sau setează-le
# în panoul hostingului (producție). NU comite niciodată `.env.local`.
# ─────────────────────────────────────────────────────────────

# Domeniul public al site-ului, fără slash la final.
# Folosit pentru canonical, hreflang, sitemap, Open Graph și JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.domeniul-tau.md

# `true` doar pe mediile de test (staging) — blochează indexarea.
NEXT_PUBLIC_NOINDEX=false

# ── Email programări (server-only, niciodată în browser) ─────
# Varianta A: Gmail / Google Workspace cu „App Password”
#   (necesită 2FA pe cont; parola contului NU funcționează și NU trebuie folosită)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=talchivbogdan03@gmail.com
SMTP_PASS=

# Varianta B: Gmail OAuth2 (în loc de SMTP_PASS)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# Expeditorul afișat în emailuri (trebuie să aparțină contului SMTP)
MAIL_FROM="ForceCar <talchivbogdan03@gmail.com>"

# Unde ajung cererile de programare (una sau mai multe adrese, separate prin virgulă).
# Dacă lipsește, se folosește emailul public din src/config/business.ts.
BOOKING_TO_EMAIL=talchivbogdan03@gmail.com

# Încărcare fotografii în formularul de programare (atașate doar la emailul intern, nu se salvează pe server)
BOOKING_UPLOADS_ENABLED=true

# ── Asistent AI (server-only) ────────────────────────────────
# Lasă AI_PROVIDER gol pentru asistentul fără AI (FAQ + programare + contact).
# AI-ul se activează doar când AI_PROVIDER, AI_API_KEY și AI_MODEL sunt TOATE setate.
# Valori: openai | anthropic
AI_PROVIDER=
AI_API_KEY=
# Obligatoriu — numele exact al modelului din contul furnizorului (ex. un model „mini”/„haiku”, rapid și ieftin)
AI_MODEL=
# Opțional: endpoint compatibil OpenAI (ex. Azure/OpenRouter). Implicit: https://api.openai.com/v1
AI_BASE_URL=

# ── Analytics & marketing (ID-uri publice, încărcate DOAR după consimțământ) ──
# Dacă setezi GTM, configurează GA4 / Google Ads / Meta din GTM (nu le seta și aici — evită dublarea).
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_BOOKING_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=

# Verificare Google Search Console (doar valoarea din meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
